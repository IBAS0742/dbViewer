  "chartPresets": [
    {
      "id": "year-count-line",
      "name": "逐年火点数量趋势（折线）",
      "table": "*",
      "type": "line",
      "x": "year",
      "agg": "count",
      "sort": "x-asc",
      "title": "逐年火点数量趋势"
    },
    {
      "id": "year-count-area",
      "name": "逐年火点数量（面积图）",
      "table": "*",
      "type": "area",
      "x": "year",
      "agg": "count",
      "sort": "x-asc",
      "title": "逐年火点数量（面积图）"
    },
    {
      "id": "month-count",
      "name": "各月份火点数量分布（柱状）",
      "table": "*",
      "type": "bar",
      "x": "month",
      "agg": "count",
      "sort": "x-asc",
      "title": "各月份火点数量分布"
    },
    {
      "id": "year-satellite",
      "name": "各年份分卫星火点数量（堆叠柱状）",
      "table": "*",
      "type": "bar",
      "x": "year",
      "series": "SATELLITE",
      "agg": "count",
      "stacked": true,
      "sort": "x-asc",
      "title": "各年份分卫星火点数量"
    },
    {
      "id": "elevation-hist",
      "name": "海拔分布直方图（自动分箱）",
      "table": "*",
      "type": "bar",
      "x": "elevation",
      "xBins": 24,
      "agg": "count",
      "sort": "x-asc",
      "title": "火点海拔分布"
    },
    {
      "id": "avg-frp-by-year",
      "name": "逐年平均火点功率（折线）",
      "table": "*",
      "type": "line",
      "x": "year",
      "y": "FRP",
      "agg": "avg",
      "sort": "x-asc",
      "title": "逐年平均火点功率 FRP"
    },
    {
      "id": "conf-pie",
      "name": "各置信等级火点占比（饼图）",
      "table": "*",
      "type": "pie",
      "nameField": "conf",
      "agg": "count",
      "title": "火点置信等级占比"
    },
    {
      "id": "daynight-doughnut",
      "name": "昼夜火点占比（环形图）",
      "table": "*",
      "type": "doughnut",
      "nameField": "DAYNIGHT",
      "agg": "count",
      "title": "昼夜火点占比"
    },
    {
      "id": "conf-funnel",
      "name": "各置信等级火点数量（漏斗）",
      "table": "*",
      "type": "funnel",
      "nameField": "conf",
      "agg": "count",
      "title": "各置信等级火点数量"
    },
    {
      "id": "year-elev-heat",
      "name": "年份×海拔 火点密度（热力图）",
      "table": "*",
      "type": "heatmap",
      "x": "year",
      "y": "elevation",
      "yBins": 14,
      "agg": "count",
      "title": "年份×海拔 火点数量热力图"
    },
    {
      "id": "month-elev-heat",
      "name": "月份×海拔 火点密度（热力图）",
      "table": "*",
      "type": "heatmap",
      "x": "month",
      "y": "elevation",
      "yBins": 12,
      "agg": "count",
      "title": "月份×海拔 火点数量热力图"
    },
    {
      "id": "year-elev-bar3d",
      "name": "年份×海拔 火点数量（3D柱状）",
      "table": "*",
      "type": "bar3D",
      "x": "year",
      "y": "elevation",
      "yBins": 14,
      "agg": "count",
      "title": "年份×海拔 火点数量 3D 柱状图"
    },
    {
      "id": "ndvi-elev-scatter",
      "name": "NDVI 与海拔关系（散点）",
      "table": "*",
      "type": "scatter",
      "x": "ndvi",
      "y": "elevation",
      "title": "NDVI 与海拔关系"
    },
    {
      "id": "bright-frp-bubble",
      "name": "亮度-亮温-功率气泡图",
      "table": "*",
      "type": "bubble",
      "x": "BRIGHTNESS",
      "y": "BRIGHT_T31",
      "size": "FRP",
      "title": "辐射亮度 × 亮温 × 火点功率"
    },
    {
      "id": "year-elev-frp-3d",
      "name": "年份-海拔-火点功率（3D散点）",
      "table": "*",
      "type": "scatter3D",
      "x": "year",
      "y": "elevation",
      "z": "FRP",
      "value": "CONFIDENCE",
      "title": "年份-海拔-火点功率（颜色=置信度）"
    },
    {
      "id": "forest-heat",
      "name": "高森林覆盖区 年份×海拔（热力图）",
      "table": "*",
      "type": "heatmap",
      "x": "year",
      "y": "elevation",
      "yBins": 12,
      "agg": "count",
      "title": "森林覆盖>50% 的火点分布",
      "filters": [
        { "col": "lt_forest", "op": "between", "values": [0.5, ""] }
      ]
    }
  ]
}
