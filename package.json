{
  "name": "db-chart-explorer",
  "productName": "数据图表浏览器",
  "version": "1.0.0",
  "description": "选择 SQLite db 文件 → 生成过滤表单 → 过滤/聚合数据 → ECharts 绘图 → 导出 Excel/CSV",
  "author": { "name": "db-chart-explorer", "email": "1091021117@qq.com" },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test-pipeline.js",
    "demo": "node scripts/serve-demo.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "puppeteer-core": "^25.12.0"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "echarts-gl": "^2.0.9",
    "sql.js": "^1.13.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.libo.db-chart-explorer",
    "productName": "数据图表浏览器",
    "executableName": "db-chart-explorer",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "config.json",
      "renderer/**"
    ],
    "asarUnpack": [
      "node_modules/sql.js/**"
    ],
    "extraResources": [
      { "from": "config.json", "to": "config.json" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "identity": null,
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "linux": {
      "category": "Science",
      "maintainer": "db-chart-explorer <1091021117@qq.com>",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
